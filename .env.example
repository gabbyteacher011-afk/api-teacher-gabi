# Conexão com o PostgreSQL
DATABASE_URL=postgres://usuario:senha@host:5432/banco
# Segredo para assinar os logins (gere um valor longo e aleatório: openssl rand -hex 32)
JWT_SECRET=troque-por-um-segredo-longo
# Endereço do front-end autorizado a chamar a API (sem barra no final). Pode listar vários, separados por vírgula.
CORS_ORIGIN=https://gabbyteacher011-afk.github.io
PORT=3000
# Duração do login em horas (padrão 168 = 7 dias)
TOKEN_HOURS=168
# true se o banco exige SSL (comum em serviços gratuitos)
DATABASE_SSL=false
